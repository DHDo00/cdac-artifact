+static void cdac_fuse_file_identity(const struct file *file,
+				    unsigned long *ino,
+				    dev_t *s_dev,
+				    int *f_flags,
+				    fmode_t *f_mode)
+{
+	struct inode *inode;
+
+	*ino = 0;
+	*s_dev = 0;
+	*f_flags = 0;
+	*f_mode = 0;
+
+	if (!file)
+		return;
+
+	inode = file_inode((struct file *)file);
+	if (!inode)
+		return;
+
+	*ino = (unsigned long)inode->i_ino;
+	if (inode->i_sb)
+		*s_dev = inode->i_sb->s_dev;
+	*f_flags = file->f_flags;
+	*f_mode = file->f_mode;
+}
+
+static u64 cdac_fuse_bpf_relation_id(const struct fuse_conn *fc, u64 nodeid,
+				     int backing_id, u64 mapping_generation)
+{
+	u64 h = ((u64)MAJOR(fc->dev) << 48) |
+		((u64)MINOR(fc->dev) << 32) |
+		(u32)backing_id;
+
+	h ^= nodeid + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
+	h ^= mapping_generation + 0xbf58476d1ce4e5b9ULL + (h << 6) + (h >> 2);
+	h ^= h >> 33;
+	h *= 0xff51afd7ed558ccdULL;
+	h ^= h >> 33;
+	return h ?: 1;
+}
+
+static void cdac_audit_bpf_direct_relation(struct fuse_conn *fc, u64 nodeid,
