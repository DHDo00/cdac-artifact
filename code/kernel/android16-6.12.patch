+	pr_info("CDAC_FUSE_PROXY_ASSOCIATE ts_ns=%llu audit_seq=%llu relation_type=DIRECT_BACKING_FILE_REFERENCE relation_stage=OPEN_TIME source=%s connection_identity=%u:%u nodeid=%llu backing_id=%d mapping_generation=%llu relation_id=%llu lower_file_cookie=%llu proxy_file_cookie=%llu lower_inode=%lu lower_s_dev=%u:%u lower_f_flags=0x%x lower_f_mode=0x%x proxy_inode=%lu proxy_s_dev=%u:%u proxy_f_flags=0x%x proxy_f_mode=0x%x association_pid=%d association_tid=%d result=%s\n",
