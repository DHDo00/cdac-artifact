+static int cdac_apply_bpf_direct_relation_decision(struct fuse_conn *fc,
+						   u64 nodeid,
+						   struct file *proxy_file,
+						   struct file *backing_file,
+						   struct fuse_file *ff,
+						   const char *source)
+{
+	struct iguard_relation_decision_input input;
+	unsigned long lower_ino, proxy_ino;
+	dev_t lower_s_dev, proxy_s_dev;
+	int lower_flags, proxy_flags;
+	fmode_t lower_f_mode, proxy_f_mode;
+
+	memset(&input, 0, sizeof(input));
+	cdac_fuse_file_identity(backing_file, &lower_ino, &lower_s_dev,
+				&lower_flags, &lower_f_mode);
+	cdac_fuse_file_identity(proxy_file, &proxy_ino, &proxy_s_dev,
+				&proxy_flags, &proxy_f_mode);
+
+	input.relation_type = IGUARD_RELATION_TYPE_DIRECT_BACKING_FILE_REFERENCE;
+	input.relation_stage = IGUARD_RELATION_STAGE_OPEN_TIME;
+	input.connection_major = MAJOR(fc->dev);
+	input.connection_minor = MINOR(fc->dev);
+	input.nodeid = nodeid;
+	input.mapping_generation = ff ? ff->cdac_mapping_generation : 0;
