+		task_tgid_nr(current), task_pid_nr(current),
+		backing_file ? "success" : "missing_file");
+	pr_info("CDAC_FUSE_BACKING_LOOKUP ts_ns=%llu audit_seq=%llu relation_type=DIRECT_BACKING_FILE_REFERENCE relation_stage=OPEN_TIME source=%s connection_identity=%u:%u nodeid=%llu backing_id=%d mapping_generation=%llu relation_id=%llu lower_file_cookie=%llu lookup_pid=%d lookup_tid=%d result=%s\n",
