+	query.ino = inode ? inode->i_ino : 0;
+	query.s_dev_major = inode && inode->i_sb ? MAJOR(inode->i_sb->s_dev) : 0;
+	query.s_dev_minor = inode && inode->i_sb ? MINOR(inode->i_sb->s_dev) : 0;
+	query.i_mode = inode ? inode->i_mode : 0;
+	query.f_flags = lower_file->f_flags;
+	query.f_mode = lower_file->f_mode;
+
+	fdput(lower);
+
+	if (copy_to_user(argp, &query, sizeof(query)))
+		return -EFAULT;
