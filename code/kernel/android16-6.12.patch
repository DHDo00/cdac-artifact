+	fmode_t lower_f_mode, proxy_f_mode;
+	u64 lower_cookie, proxy_cookie;
+
+	proxy_cookie = iguard_file_cookie(proxy_file);
+	ff->cdac_proxy_file_cookie = proxy_cookie;
+
+	if (!iguard_ctx_verbose_audit_enabled())
+		return;
+
+	cdac_fuse_file_identity(backing_file, &lower_ino, &lower_s_dev,
+				&lower_flags, &lower_f_mode);
+	cdac_fuse_file_identity(proxy_file, &proxy_ino, &proxy_s_dev,
+				&proxy_flags, &proxy_f_mode);
+	lower_cookie = iguard_file_cookie(backing_file);
+
+	pr_info("CDAC_FUSE_BACKING_REGISTER ts_ns=%llu audit_seq=%llu relation_type=DIRECT_BACKING_FILE_REFERENCE relation_stage=OPEN_TIME source=%s connection_identity=%u:%u nodeid=%llu backing_id=%d mapping_generation=%llu relation_id=%llu backing_fd=-1 lower_file_cookie=%llu lower_inode=%lu lower_s_dev=%u:%u lower_f_flags=0x%x lower_f_mode=0x%x creator_pid=%d creator_tid=%d result=%s\n",
+		(unsigned long long)ktime_get_ns(),
+		(unsigned long long)iguard_audit_next_seq(),
