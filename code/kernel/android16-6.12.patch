+static u64 cdac_fuse_relation_id(const struct fuse_conn *fc, u64 nodeid,
+				 int backing_id, u64 mapping_generation)
+{
+	u64 h = ((u64)MAJOR(fc->dev) << 48) |
+		((u64)MINOR(fc->dev) << 32) |
+		(u32)backing_id;
+
+	h ^= nodeid + 0x9e3779b97f4a7c15ULL + (h << 6) + (h >> 2);
+	h ^= mapping_generation + 0xbf58476d1ce4e5b9ULL + (h << 6) + (h >> 2);
+	h ^= h >> 33;
+	h *= 0xff51afd7ed558ccdULL;
+	h ^= h >> 33;
+	return h ?: 1;
+}
