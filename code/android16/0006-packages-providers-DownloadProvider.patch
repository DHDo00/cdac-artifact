+    /*
+     * I-Guard provider-side validation for DownloadProvider.openFile().
+     *
+     * DownloadProvider runs outside system_server. Therefore, this validation
+     * path writes the fixed-size iguard_msg directly to /dev/iguard_ctl from
+     * the provider Binder thread that later opens the backing file. This keeps
+     * the published context on the same thread as the VFS file-open operation.
+     */
+    private static final String IGUARD_CTL_PATH = "/dev/iguard_ctl";
+    private static final int IGUARD_MAGIC = 0x49475544;
+    private static final int IGUARD_VERSION = 1;
+    private static final int IGUARD_MSG_REPORT = 1;
+    private static final int IGUARD_MSG_INVALIDATE = 2;
+
+    private static final int IGUARD_MSG_LEN = 112;
+    private static final int IGUARD_SERVICE_LEN = 32;
+    private static final int IGUARD_OP_LEN = 32;
+
+    private static final int IGUARD_SERVICE_DOWNLOAD_PROVIDER = 4;
+    private static final int IGUARD_OP_DOWNLOAD_OPEN_FILE = 301;
+
+    private static final String IGUARD_SERVICE_NAME = "download_provider";
+    private static final String IGUARD_OP_OPEN_FILE = "openFile";
+
+    private static void putIguardFixedString(ByteBuffer buf, String value, int len) {
+        final byte[] raw = value.getBytes(StandardCharsets.UTF_8);
+        final int n = Math.min(raw.length, len - 1);
+        buf.put(raw, 0, n);
+        for (int i = n; i < len; i++) {
+            buf.put((byte) 0);
+        }
+    }
+
+    private static boolean iguardWriteMsg(int msgType, int callingUid, int callingPid,
+            String operationName) {
+        final ByteBuffer buf = ByteBuffer.allocate(IGUARD_MSG_LEN);
+        buf.order(ByteOrder.nativeOrder());
+
+        buf.putInt(IGUARD_MAGIC);
+        buf.putInt(IGUARD_VERSION);
+        buf.putInt(msgType);
+        buf.putInt(IGUARD_MSG_LEN);
+
+        buf.putInt(callingUid);
+        buf.putInt(callingPid);
+
+        buf.putInt(IGUARD_SERVICE_DOWNLOAD_PROVIDER);
+        buf.putInt(IGUARD_OP_DOWNLOAD_OPEN_FILE);
+
+        putIguardFixedString(buf, IGUARD_SERVICE_NAME, IGUARD_SERVICE_LEN);
+        putIguardFixedString(buf, operationName, IGUARD_OP_LEN);
+
+        buf.putLong(0L); // object_id
+        buf.putInt(0);   // flags
+        // The allocated buffer is 112 bytes; the remaining struct padding bytes
+        // stay zero-initialized, matching the kernel-side iguard_msg size.
+
+        try (FileOutputStream out = new FileOutputStream(IGUARD_CTL_PATH)) {
+            out.write(buf.array());
+            out.flush();
+
+            Log.i(Constants.TAG, "IguardDownloadProvider write ok"
+                    + " type=" + msgType
+                    + " callerUid=" + callingUid
+                    + " callerPid=" + callingPid
+                    + " service_id=" + IGUARD_SERVICE_DOWNLOAD_PROVIDER
+                    + " op_id=" + IGUARD_OP_DOWNLOAD_OPEN_FILE
+                    + " service=" + IGUARD_SERVICE_NAME
+                    + " operation=" + operationName);
+            return true;
+        } catch (Throwable t) {
+            Log.w(Constants.TAG, "IguardDownloadProvider write failed"
+                    + " type=" + msgType
+                    + " callerUid=" + callingUid
+                    + " callerPid=" + callingPid
+                    + " service=" + IGUARD_SERVICE_NAME
+                    + " operation=" + operationName, t);
+            return false;
+        }
+    }
+
+    private static boolean iguardReportCaller(String operationName) {
+        return iguardWriteMsg(IGUARD_MSG_REPORT,
+                Binder.getCallingUid(),
+                Binder.getCallingPid(),
+                operationName);
+    }
+
+    private static void iguardInvalidateCaller(String operationName) {
+        iguardWriteMsg(IGUARD_MSG_INVALIDATE, 0, 0, operationName);
+    }
