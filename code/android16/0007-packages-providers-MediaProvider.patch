+static uint64_t cdac_fuse_mix64(uint64_t v) {
+    v ^= v >> 33;
+    v *= 0xff51afd7ed558ccdULL;
+    v ^= v >> 33;
+    v *= 0xc4ceb9fe1a85ec53ULL;
+    v ^= v >> 33;
+    return v;
+}
+
+static uint64_t cdac_fuse_relation_id(uint64_t connection_id, uint64_t request_unique,
+                                      uint64_t nodeid, uint64_t fh) {
+    uint64_t id = 0x4344414346555345ULL;
+    id ^= cdac_fuse_mix64(connection_id);
+    id ^= cdac_fuse_mix64(request_unique + 0x9e3779b97f4a7c15ULL);
+    id ^= cdac_fuse_mix64(nodeid + 0xbf58476d1ce4e5b9ULL);
+    id ^= cdac_fuse_mix64(fh + 0x94d049bb133111ebULL);
+    return cdac_fuse_mix64(id);
+}
+
+static uint64_t cdac_fuse_connection_id(fuse_req_t req) {
+    (void) req;
+    return 0;
+}
+
+static uint64_t cdac_fuse_ts_ns() {
+    struct timespec ts = {};
+    clock_gettime(CLOCK_BOOTTIME, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
+}
+
+static int cdac_fuse_query_fd_cookie(fuse_req_t req, int fd,
+                                     struct fuse_fd_cookie_query* query) {
+    memset(query, 0, sizeof(*query));
+    query->fd = fd;
+    return ioctl(req->se->fd, FUSE_DEV_IOC_FD_COOKIE, query);
+}
