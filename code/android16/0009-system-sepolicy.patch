diff --git a/private/platform_app.te b/private/platform_app.te
index a8374cba2..7395b1aa3 100644
--- a/private/platform_app.te
+++ b/private/platform_app.te
@@ -148,6 +148,15 @@ virtualizationservice_use(platform_app)
 # Allow platform apps to read files and directories under /data/system/shutdown-checkpoints/
 r_dir_file(platform_app, shutdown_checkpoints_system_data_file)
 
+#DH
+allow platform_app iguard_demo_service:service_manager find;
+
+# I-Guard experiment: ExternalStorageProvider runs in the platform_app domain
+# on this Cuttlefish build and publishes final-provider entry context here.
+allow platform_app iguard_ctl_device:chr_file { getattr open write };
+
+
+
