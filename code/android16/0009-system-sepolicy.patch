diff --git a/private/priv_app.te b/private/priv_app.te
index 102fa519b..e1328a399 100644
--- a/private/priv_app.te
+++ b/private/priv_app.te
@@ -25,6 +25,11 @@ create_pty(priv_app)
 # TODO: Tighten (b/112357170)
 allow priv_app privapp_data_file:file execute;
 
+# CDAC S12 CallLogProvider.openFile() provider-local capture. CallLogProvider
+# runs in android.process.acore under priv_app and only publishes caller/route
+# context to the kernel decision point.
+allow priv_app iguard_ctl_device:chr_file { getattr open write };
+
 # Chrome Crashpad uses the the dynamic linker to load native executables
 # from an APK (b/112050209, crbug.com/928422)
 allow priv_app system_linker_exec:file execute_no_trans;
