+    private void runTimerCalibration(Intent intent, int pairs) throws Exception {
+        String session = extra(intent, "session_id", "calibration");
+        long[] deltas = new long[pairs];
+        for (int i = 0; i < pairs; i++) {
+            long start = SystemClock.elapsedRealtimeNanos();
+            long end = SystemClock.elapsedRealtimeNanos();
+            deltas[i] = end - start;
+        }
+        Arrays.sort(deltas);
+        File out = resultFile("timer_calibration_" + clean(session) + ".tsv");
+        try (FileOutputStream fos = new FileOutputStream(out, false)) {
+            String text = "timer_api\tpair_count\tmedian_ns\tp95_ns\tp99_ns\n"
+                    + "SystemClock.elapsedRealtimeNanos\t" + pairs + "\t"
+                    + percentileSorted(deltas, 50) + "\t"
+                    + percentileSorted(deltas, 95) + "\t"
+                    + percentileSorted(deltas, 99) + "\n";
+            fos.write(text.getBytes(StandardCharsets.UTF_8));
+        }
+        writeStatus(session, "status=done scenario=timer_calibration path="
